        background: #2ed573;
        color: white;
        margin-left: auto;
    }

        .btn-next:hover {
            background: #26af5f;
        }

    .result-alert {
        margin-top: 15px;
        padding: 12px;
        border-radius: 8px;
        text-align: center;
        font-weight: 500;
    }

    .alert-success {
        background: #d4edda;
        color: #155724;
    }

    .alert-error {
        background: #f8d7da;
        color: #721c24;
    }
</style>

@code {
    private enum Seviye { Kolay, Orta, Zor }
    private Seviye _aktifSeviye = Seviye.Kolay;

    private int _soruNumarasi = 1;
    private List<string> _gercekCevap = new();
    private List<string> _secilenCevap;
    private List<List<string>> _secenekler = new();
    private List<string> _tumRitimler = new() { "van", "izmir", "ankara", "karaman", "gelibolu", "terazi" };

    private string _sonucMesaji = "";
    private bool _dogruMu = false;
    private bool _cevabiGosterildi = false;
    private Random _rnd = new Random();

    protected override void OnInitialized()
    {
        YeniSoruUret(true);
    }

    private void SeviyeDegistir(Seviye yeniSeviye)
    {
        _aktifSeviye = yeniSeviye;
        YeniSoruUret(true);
    }

    private void SonrakiSoru()
    {
        YeniSoruUret(false);
    }

    private void YeniSoruUret(bool sifirla)
    {
        if (sifirla) _soruNumarasi = 1;
        else _soruNumarasi++;

        _secilenCevap = null;
        _sonucMesaji = "";
        _dogruMu = false;
        _cevabiGosterildi = false;
        _gercekCevap.Clear();
        _secenekler.Clear();

        int ritimSayisi = _aktifSeviye switch
        {
            Seviye.Kolay => 3,
            Seviye.Orta => 5,
            Seviye.Zor => 7,
            _ => 3
        };

        for (int i = 0; i < ritimSayisi; i++)
        {
            _gercekCevap.Add(_tumRitimler[_rnd.Next(_tumRitimler.Count)]);
        }
        _secenekler.Add(new List<string>(_gercekCevap));

        while (_secenekler.Count < 4)
        {
            var celdirici = new List<string>();
            for (int i = 0; i < ritimSayisi; i++)
            {
                celdirici.Add(_tumRitimler[_rnd.Next(_tumRitimler.Count)]);
            }

            bool secenekZatenVarMi = _secenekler.Any(s => s.SequenceEqual(celdirici));
            if (!secenekZatenVarMi)
            {
                _secenekler.Add(celdirici);
            }
        }

        _secenekler = _secenekler.OrderBy(x => _rnd.Next()).ToList();
    }

    private async Task SoruyuCal()
    {
        await JS.InvokeVoidAsync("sesMotoru.diziyiCal", _gercekCevap);
    }

    private void SecenekTiklandi(List<string> tiklananSecenek)
    {
        _secilenCevap = tiklananSecenek;

        if (_secilenCevap.SequenceEqual(_gercekCevap))
        {
            _dogruMu = true;
            _sonucMesaji = "Tebrikler! Doğru şıkkı buldun.";
        }
        else
        {
            _dogruMu = false;
            _sonucMesaji = "Yanlış oldu. Duyduğun ritmi tekrar dinle ve başka bir şıkkı dene.";
        }
    }

    private void CevabiGoster()
    {
        _cevabiGosterildi = true;
        _sonucMesaji = "Doğru ritim yeşil ile işaretlendi.";
    }
}